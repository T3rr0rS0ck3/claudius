<Window x:Class="Claudius.Views.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Claudius.Core"
        Title="{x:Static core:Strings.InventoryTitle}"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F5F4EF">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#77736B" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SlotLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B5B1A8" />
                <Setter Property="Margin" Value="2,10,0,4" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Same frame as the settings window -->
    <Grid Margin="10">
        <Border Background="#262624" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" />
            </Border.Effect>
        </Border>
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12">
    <StackPanel Margin="18,12,18,16">
        <Grid Margin="0,0,0,8" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Title_MouseLeftButtonDown">
            <TextBlock Text="{x:Static core:Strings.InventoryHeading}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"
                       FontFamily="Consolas" HorizontalAlignment="Center" />
            <TextBlock x:Name="CloseButton" Text="✕" Foreground="#77736B" FontSize="12" Cursor="Hand" HorizontalAlignment="Right"
                       VerticalAlignment="Center" MouseLeftButtonUp="Close_Click" ToolTip="{x:Static core:Strings.Close}" />
        </Grid>

        <!-- Tabs, filled in code -->
        <UniformGrid x:Name="TabStrip" Rows="1" Margin="0,0,0,12" />

        <!-- Model: which model and effort new sessions start with -->
        <StackPanel x:Name="ModelPanel">
            <UniformGrid x:Name="Tiles" Columns="5" />
            <TextBlock x:Name="OtherModelText" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static core:Strings.Effort}" VerticalAlignment="Center" ToolTip="{x:Static core:Strings.EffortTip}" />
                <Slider x:Name="EffortSlider" Grid.Column="1" Minimum="0" Maximum="4" TickFrequency="1"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center" ToolTip="{x:Static core:Strings.EffortTip}"
                        ValueChanged="EffortSlider_ValueChanged" />
                <TextBlock x:Name="EffortText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock x:Name="EffortHint" Text="{x:Static core:Strings.EffortNeedsModel}" Style="{StaticResource Hint}"
                       Margin="0,2,0,0" Visibility="Collapsed" />
            <Border Height="1" Background="#3A3936" Margin="0,12,0,8" />
            <TextBlock Text="{x:Static core:Strings.InventoryHint}" Style="{StaticResource Hint}" />
        </StackPanel>

        <!-- Wardrobe: an outfit per model, one item per slot -->
        <StackPanel x:Name="WardrobePanel" Visibility="Collapsed">
            <!-- Options for every model, kept apart from the outfit of the model being dressed -->
            <GroupBox Header="{x:Static core:Strings.GroupAllModels}" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="ModelOutfitsBox" Content="{x:Static core:Strings.ModelOutfits}"
                              ToolTip="{x:Static core:Strings.ModelOutfitsTip}" Click="WardrobeOption_Click" />
                    <CheckBox x:Name="SeasonalBox" Content="{x:Static core:Strings.SeasonalAccessories}"
                              ToolTip="{x:Static core:Strings.SeasonalAccessoriesTip}" Click="WardrobeOption_Click" />
                    <StackPanel Orientation="Horizontal" Margin="22,0,0,0" IsEnabled="{Binding IsChecked, ElementName=SeasonalBox}">
                        <TextBlock Text="{x:Static core:Strings.Birthday}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="BirthdayDayBox" Width="56" SelectionChanged="Birthday_SelectionChanged" />
                        <ComboBox x:Name="BirthdayMonthBox" Width="120" Margin="6,0,0,0" SelectionChanged="Birthday_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{x:Static core:Strings.GroupOutfitPerModel}" Margin="0">
                <StackPanel>
                    <UniformGrid x:Name="FamilyChips" Rows="1" />
                    <Border Background="#1E1E1C" CornerRadius="8" Margin="0,10,0,0" Padding="0,10">
                        <Image x:Name="WardrobePreview" Width="132" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Text="{x:Static core:Strings.SlotHead}" Style="{StaticResource SlotLabel}" />
                    <WrapPanel x:Name="HatItems" />
                    <TextBlock Text="{x:Static core:Strings.SlotFace}" Style="{StaticResource SlotLabel}" />
                    <WrapPanel x:Name="FaceItems" />
                    <TextBlock Text="{x:Static core:Strings.SlotNeck}" Style="{StaticResource SlotLabel}" />
                    <WrapPanel x:Name="NeckItems" />
                    <Button Content="{x:Static core:Strings.ResetOutfit}" HorizontalAlignment="Left" Padding="10,3" Margin="0,12,0,0"
                            Click="ResetOutfit_Click" />
                </StackPanel>
            </GroupBox>
            <Border Height="1" Background="#3A3936" Margin="0,12,0,8" />
            <TextBlock Text="{x:Static core:Strings.WardrobeHint}" Style="{StaticResource Hint}" />
        </StackPanel>

        <!-- Color of the pet, also the accent color of the app -->
        <StackPanel x:Name="ColorPanel" Visibility="Collapsed">
            <Border Background="#1E1E1C" CornerRadius="8" Padding="0,10">
                <Image x:Name="ColorPreview" Width="132" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <TextBlock Text="{x:Static core:Strings.ColorPresets}" Style="{StaticResource SlotLabel}" />
            <WrapPanel x:Name="Swatches" />
            <TextBlock Text="{x:Static core:Strings.HexColor}" Style="{StaticResource SlotLabel}" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ColorBox" Width="90" MaxLength="7" KeyDown="ColorBox_KeyDown" LostFocus="ColorBox_LostFocus" />
                <Button Content="{x:Static core:Strings.PickColor}" Padding="10,2" Margin="6,0,0,0" Click="PickColor_Click" />
                <Button Content="{x:Static core:Strings.DefaultColor}" Padding="10,2" Margin="6,0,0,0" Click="DefaultColor_Click" />
            </StackPanel>
            <CheckBox x:Name="TerminalMascotBox" Content="{x:Static core:Strings.MascotColor}" Margin="0,12,0,0"
                      ToolTip="{x:Static core:Strings.MascotColorTip}" Click="TerminalMascotBox_Click" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
    </StackPanel>
        </Border>
    </Grid>
</Window>
