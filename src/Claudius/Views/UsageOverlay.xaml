<Window x:Class="Claudius.Views.UsageOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Claudius.Core"
        xmlns:views="clr-namespace:Claudius.Views"
        Title="Claudius"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="Height"
        Width="320">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A8A49B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Info" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D6D2C8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Pct" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F4EF" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="#262624" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12" Padding="16,12,16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <TextBlock Text="{x:Static core:Strings.OverlayHeading}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"
                           FontFamily="Consolas" HorizontalAlignment="Center" />
                <TextBlock x:Name="CloseButton" Text="✕" Foreground="#77736B" FontSize="12" Cursor="Hand"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           MouseLeftButtonUp="CloseButton_Click" ToolTip="{x:Static core:Strings.Close}" />
            </Grid>

            <TextBlock Text="{x:Static core:Strings.SessionHeading}" Style="{StaticResource Label}" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid x:Name="SessionBar" Rows="1" Columns="20" Height="16" />
                <TextBlock x:Name="SessionPct" Grid.Column="1" Style="{StaticResource Pct}" Text="– %" />
                <views:UsageChart x:Name="SessionChart" Grid.Row="1" Height="44" Margin="1,4,1,0"
                                  Stroke="{DynamicResource AccentBrush}" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="SessionReset" Style="{StaticResource Info}" />
            <TextBlock x:Name="SessionForecast" Style="{StaticResource Info}" Foreground="#A8A49B" FontStyle="Italic" />

            <TextBlock Text="{x:Static core:Strings.WeekHeading}" Style="{StaticResource Label}" Margin="0,14,0,0" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <UniformGrid x:Name="WeekBar" Rows="1" Columns="20" Height="16" />
                <TextBlock x:Name="WeekPct" Grid.Column="1" Style="{StaticResource Pct}" Text="– %" />
                <views:UsageChart x:Name="WeekChart" Grid.Row="1" Height="44" Margin="1,4,1,0"
                                  Stroke="{DynamicResource AccentBrush}" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="WeekReset" Style="{StaticResource Info}" />
            <TextBlock x:Name="WeekForecast" Style="{StaticResource Info}" Foreground="#A8A49B" FontStyle="Italic" />

            <Border Height="1" Background="#3A3936" Margin="0,12,0,10" />
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="#6FBF73" VerticalAlignment="Center" />
                <TextBlock x:Name="StateText" Foreground="#F5F4EF" FontSize="13" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="UpdatedText" Style="{StaticResource Info}" Foreground="#77736B" FontSize="11" Margin="0,6,0,0" />
            <TextBlock x:Name="HintText" Style="{StaticResource Info}" Foreground="#E5C14B" Visibility="Collapsed" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</Window>
