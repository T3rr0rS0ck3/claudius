<Window x:Class="Claudius.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Claudius.Core"
        Title="{x:Static core:Strings.SettingsTitle}"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" FontSize="13" Foreground="#F5F4EF">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#77736B" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Same frame as the usage overlay; the shadow sits on its own layer so the text stays crisp -->
    <Grid Margin="10">
        <Border Background="#262624" CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" />
            </Border.Effect>
        </Border>
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="12">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="18,12,18,10" Background="Transparent" Cursor="SizeAll"
              MouseLeftButtonDown="Title_MouseLeftButtonDown">
            <TextBlock Text="{x:Static core:Strings.SettingsHeading}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"
                       FontFamily="Consolas" HorizontalAlignment="Center" />
            <TextBlock Text="✕" Foreground="#77736B" FontSize="12" Cursor="Hand" HorizontalAlignment="Right"
                       VerticalAlignment="Center" MouseLeftButtonUp="Close_Click" ToolTip="{x:Static core:Strings.Close}" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Margin="18,6,18,16">
            <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static core:Strings.Save}" Width="100" Padding="0,5" IsDefault="True" Click="Save_Click"
                        Style="{StaticResource PrimaryButton}" />
                <Button Content="{x:Static core:Strings.Cancel}" Width="100" Padding="0,5" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Height="1" Background="#3A3936" Margin="18,0" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18,0,8,0" Padding="0,0,10,0">
    <StackPanel Margin="0,4,0,0">
        <GroupBox Header="{x:Static core:Strings.GroupGeneral}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static core:Strings.Language}" VerticalAlignment="Center" />
                <!-- Each language in its own name, so it can be found in either -->
                <ComboBox x:Name="LanguageBox" Grid.Column="1" />
            </Grid>
        </GroupBox>

        <GroupBox Header="{x:Static core:Strings.GroupAssistant}">
            <StackPanel>
                <TextBlock x:Name="SetupStatusText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="ConnectButton" Content="{x:Static core:Strings.ConnectButton}" Padding="10,3" Click="Connect_Click" />
                    <Button x:Name="DisconnectButton" Content="{x:Static core:Strings.Disconnect}" Padding="10,3" Margin="8,0,0,0" Click="Disconnect_Click" />
                </StackPanel>
                <CheckBox x:Name="SessionMarksBox" Content="{x:Static core:Strings.SessionMarks}" Margin="0,8,0,4"
                          ToolTip="{x:Static core:Strings.SessionMarksTip}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{x:Static core:Strings.GroupLaunch}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.ReposFolder}" VerticalAlignment="Center"
                               ToolTip="{x:Static core:Strings.ReposFolderTip}" />
                    <TextBox x:Name="ReposPathBox" Grid.Column="1" ToolTip="{x:Static core:Strings.ReposFolderTip}" />
                    <Button Grid.Column="2" Content="…" Width="32" Padding="0" Margin="6,0,0,0" Click="BrowseRepos_Click" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.OpenAssistantIn}" VerticalAlignment="Center" />
                    <ComboBox x:Name="TerminalBox" Grid.Column="1" />
                </Grid>
                <CheckBox x:Name="GhostDragBox" Content="{x:Static core:Strings.GhostDrag}" />
                <CheckBox x:Name="VoiceBox" Content="{x:Static core:Strings.VoiceOffer}"
                          ToolTip="{x:Static core:Strings.VoiceOfferTip}" />
                <TextBlock x:Name="AssistantStatusText" Style="{StaticResource Hint}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{x:Static core:Strings.GroupPet}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.Size}" VerticalAlignment="Center" />
                    <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="2" Maximum="12" TickFrequency="1"
                            IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0}x}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.Color}" VerticalAlignment="Center" />
                    <Border x:Name="ColorPreview" Grid.Column="1" Width="24" Height="22" Margin="0,0,6,0"
                            BorderBrush="#4A4844" BorderThickness="1" CornerRadius="4" />
                    <TextBox x:Name="ColorBox" Grid.Column="2" MaxLength="7" TextChanged="ColorBox_TextChanged" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static core:Strings.PickColor}" Padding="10,2" Click="PickColor_Click" />
                        <Button Content="{x:Static core:Strings.DefaultColor}" Padding="10,2" Margin="6,0,0,0" Click="DefaultColor_Click" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="TerminalMascotBox" Content="{x:Static core:Strings.MascotColor}"
                          ToolTip="{x:Static core:Strings.MascotColorTip}" />
                <CheckBox x:Name="AlwaysOnTopBox" Content="{x:Static core:Strings.AlwaysOnTop}" />
                <CheckBox x:Name="AnimationsBox" Content="{x:Static core:Strings.Animations}" />
                <CheckBox x:Name="WalkAroundBox" Content="{x:Static core:Strings.WalkAroundDesktop}"
                          IsEnabled="{Binding IsChecked, ElementName=AnimationsBox}" />
                <CheckBox x:Name="CrossMonitorsBox" Content="{x:Static core:Strings.CrossMonitors}"
                          ToolTip="{x:Static core:Strings.CrossMonitorsTip}"
                          IsEnabled="{Binding IsChecked, ElementName=WalkAroundBox}" />
                <CheckBox x:Name="ChaseCursorBox" Content="{x:Static core:Strings.ChaseCursor}"
                          ToolTip="{x:Static core:Strings.ChaseCursorTip}"
                          IsEnabled="{Binding IsChecked, ElementName=WalkAroundBox}" />
                <CheckBox x:Name="EmotesBox" Content="{x:Static core:Strings.Emotes}" />
                <CheckBox x:Name="ModelOutfitsBox" Content="{x:Static core:Strings.ModelOutfits}"
                          ToolTip="{x:Static core:Strings.ModelOutfitsTip}" />
                <CheckBox x:Name="SeasonalBox" Content="{x:Static core:Strings.SeasonalAccessories}"
                          ToolTip="{x:Static core:Strings.SeasonalAccessoriesTip}" />
                <StackPanel Orientation="Horizontal" Margin="22,0,0,4" IsEnabled="{Binding IsChecked, ElementName=SeasonalBox}">
                    <TextBlock Text="{x:Static core:Strings.Birthday}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="BirthdayDayBox" Width="56" />
                    <ComboBox x:Name="BirthdayMonthBox" Width="120" Margin="6,0,0,0" />
                </StackPanel>
                <CheckBox x:Name="NightModeBox" Content="{x:Static core:Strings.NightMode}"
                          ToolTip="{x:Static core:Strings.NightModeTip}" />
                <StackPanel Orientation="Horizontal" Margin="22,0,0,4" IsEnabled="{Binding IsChecked, ElementName=NightModeBox}">
                    <TextBlock Text="{x:Static core:Strings.NightFrom}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="NightStartBox" Width="72" />
                    <TextBlock Text="{x:Static core:Strings.NightTo}" VerticalAlignment="Center" Margin="6,0" />
                    <ComboBox x:Name="NightEndBox" Width="72" />
                </StackPanel>
                <CheckBox x:Name="AutostartBox" Content="{x:Static core:Strings.StartWithWindows}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="USAGE">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.IntervalLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="IntervalBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.SessionWarnLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="SessionWarnBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.WeekWarnLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="WeekWarnBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.MoodLabelText}" VerticalAlignment="Center"
                               ToolTip="{x:Static core:Strings.MoodOrder}" />
                    <TextBox x:Name="MoodThresholdsBox" Grid.Column="1"
                             ToolTip="{x:Static core:Strings.MoodOrder}" />
                </Grid>
                <TextBlock Text="{x:Static core:Strings.MoodOrderHint}"
                           Style="{StaticResource Hint}" Margin="0,0,0,4" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.ContextLabelText}" VerticalAlignment="Center"
                               ToolTip="{x:Static core:Strings.ContextOrder}" />
                    <TextBox x:Name="ContextThresholdsBox" Grid.Column="1"
                             ToolTip="{x:Static core:Strings.ContextOrder}" />
                </Grid>
                <TextBlock Text="{x:Static core:Strings.ContextOrderHint}"
                           Style="{StaticResource Hint}" Margin="0,0,0,4" />
                <CheckBox x:Name="ForecastBox" Content="{x:Static core:Strings.ShowForecast}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="{x:Static core:Strings.GroupBubbles}">
            <StackPanel>
                <CheckBox x:Name="BubblesBox" Content="{x:Static core:Strings.ShowBubbles}" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.BubbleDuration}" VerticalAlignment="Center" />
                    <TextBox x:Name="BubbleDurationBox" Grid.Column="1" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static core:Strings.YourName}" VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Grid.Column="1" />
                </Grid>
                <CheckBox x:Name="NotificationsBox" Content="{x:Static core:Strings.WindowsNotifications}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="{x:Static core:Strings.EditTexts}" Padding="10,3" Click="EditTexts_Click"
                            ToolTip="{x:Static core:Strings.EditTextsTip}" />
                    <Button Content="{x:Static core:Strings.TestNotification}" Padding="10,3" Margin="8,0,0,0" Click="TestNotification_Click" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="UPDATES">
            <StackPanel>
                <TextBlock x:Name="VersionText" TextWrapping="Wrap" />
                <CheckBox x:Name="UpdatesBox" Content="{x:Static core:Strings.AutoUpdates}" Margin="0,6,0,4"
                          ToolTip="{x:Static core:Strings.AutoUpdatesTip}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button x:Name="CheckUpdateButton" Content="{x:Static core:Strings.CheckNow}" Padding="10,3" Click="CheckUpdate_Click" />
                    <Button x:Name="InstallUpdateButton" Padding="10,3" Margin="8,0,0,0" Visibility="Collapsed"
                            Click="InstallUpdate_Click" />
                </StackPanel>
                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>
        </GroupBox>

    </StackPanel>
    </ScrollViewer>
    </DockPanel>
        </Border>
    </Grid>
</Window>
