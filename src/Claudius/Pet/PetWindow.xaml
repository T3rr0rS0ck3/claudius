<Window x:Class="Claudius.Pet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claudius"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        AllowDrop="True" DragEnter="Window_DragOver" DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        Drop="Window_Drop"
        Width="260" Height="200">
    <Window.Resources>
        <Style x:Key="EmoteButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Emoji" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Background="#FFFDF8" BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="2" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                <Setter TargetName="Circle" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- A thought cloud with "!" or "?" beside the head, reaching out of the pet's picture; placed in ShowThought -->
        <Image x:Name="ThoughtImage" Grid.RowSpan="2" Stretch="Fill" HorizontalAlignment="Left"
               RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed"
               MouseLeftButtonUp="Thought_MouseLeftButtonUp" />

        <!-- Speech bubble; fully transparent window areas stay click-through -->
        <StackPanel x:Name="Bubble" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Opacity="0" Visibility="Collapsed" Cursor="Hand" Margin="0,0,0,2"
                    MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <!-- Tails pointing sideways, used while the bubble stands next to the climbing pet -->
            <Path x:Name="BubbleTailLeft" Data="M 9,0 L 9,14 L 0,7 Z" Fill="#FFFDF8" Stroke="{DynamicResource AccentBrush}"
                  StrokeThickness="2" VerticalAlignment="Top" Margin="0,12,-2,0" Visibility="Collapsed"
                  Panel.ZIndex="1" />
            <!-- Tail pointing up, used while the bubble hangs below the pet -->
            <Path x:Name="BubbleTailUp" Data="M 0,9 L 14,9 L 7,0 Z" Fill="#FFFDF8" Stroke="{DynamicResource AccentBrush}"
                  StrokeThickness="2" HorizontalAlignment="Center" Margin="0,0,0,-2" Visibility="Collapsed"
                  Panel.ZIndex="1" />
            <Border Background="#FFFDF8" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="10"
                    Padding="10,6" MaxWidth="240">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.25" />
                </Border.Effect>
                <TextBlock x:Name="BubbleText" TextWrapping="Wrap" TextAlignment="Center"
                           FontFamily="Segoe UI Semibold, Segoe UI Emoji" FontSize="13" Foreground="#2B2B2B" />
            </Border>
            <Path x:Name="BubbleTailDown" Data="M 0,0 L 14,0 L 7,9 Z" Fill="#FFFDF8" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                  HorizontalAlignment="Center" Margin="0,-2,0,0" />
            <Path x:Name="BubbleTailRight" Data="M 0,0 L 0,14 L 9,7 Z" Fill="#FFFDF8" Stroke="{DynamicResource AccentBrush}"
                  StrokeThickness="2" VerticalAlignment="Top" Margin="-2,12,0,0" Visibility="Collapsed"
                  Panel.ZIndex="1" />
        </StackPanel>

        <!-- Emotes, shown while the mouse is over the pet -->
        <StackPanel x:Name="EmoteBar" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"
                    Panel.ZIndex="1" MouseLeave="Emotes_MouseLeave">
            <!-- Tooltips come from ApplyLanguage -->
            <Button x:Name="FeedButton" Style="{StaticResource EmoteButton}" Content="🍪" Tag="Feed" Click="Emote_Click" />
            <Button Style="{StaticResource EmoteButton}" Content="❤" Tag="Pat" Click="Emote_Click" />
            <Button Style="{StaticResource EmoteButton}" Content="⚽" Tag="Play" Click="Emote_Click" />
            <Button Style="{StaticResource EmoteButton}" Content="🪶" Tag="Tickle" Click="Emote_Click" />
        </StackPanel>

        <!-- At night the bed is drawn around the pet: head end and pillow behind it, blanket in front. -->
        <Image x:Name="BedBackImage" Grid.Row="1" HorizontalAlignment="Center" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" Visibility="Collapsed" />
        <Image x:Name="PetImage" Grid.Row="1" HorizontalAlignment="Center" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" Cursor="Hand"
               MouseLeftButtonDown="Pet_MouseLeftButtonDown"
               MouseMove="Pet_MouseMove"
               MouseEnter="Pet_MouseEnter"
               MouseLeave="Emotes_MouseLeave"
               MouseLeftButtonUp="Pet_MouseLeftButtonUp"
               MouseRightButtonDown="Pet_MouseRightButtonDown"
               MouseRightButtonUp="Pet_MouseRightButtonUp"
               LostMouseCapture="Pet_LostMouseCapture"
               ContextMenuOpening="Pet_ContextMenuOpening" />
        <Image x:Name="BedFrontImage" Grid.Row="1" HorizontalAlignment="Center" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" Visibility="Collapsed" />
        <!-- After a long fall: the puddle and its splashing drops, wider than the pet. -->
        <Image x:Name="SplatImage" Grid.Row="1" HorizontalAlignment="Center" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" Visibility="Collapsed" />
        <!-- Wailing tears fly out past the pet's sides; clicks go through to the pet. -->
        <Image x:Name="TearsImage" Grid.Row="1" HorizontalAlignment="Center" Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Window>
