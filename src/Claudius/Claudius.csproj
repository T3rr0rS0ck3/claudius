<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Claudius</AssemblyName>
    <RootNamespace>Claudius</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The pet in its default color, for the exe, its shortcuts and the windows in the taskbar. -->
    <ApplicationIcon>Claudius.ico</ApplicationIcon>
    <!-- DPI awareness is declared in app.manifest for WPF; the WinForms analyzer warning (WFO0003, formerly WFAC010) does not apply. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Releases pass -p:Version from the tag (build.ps1); self-built copies are 0.0.0 and skip update checks. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share many type names; WinForms is only used for the tray icon. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\UsageData.cs" Link="Shared\UsageData.cs" />
    <Compile Include="..\Shared\SessionData.cs" Link="Shared\SessionData.cs" />
    <Compile Include="..\Shared\AssistantCli.cs" Link="Shared\AssistantCli.cs" />
  </ItemGroup>

  <!--
    Debug builds: build the bridge first and put it next to the app, so a self-built pet finds
    ClaudiusBridge.exe for the statusLine and the ?/! hooks. Releases publish both via build.ps1.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\Claudius.Bridge\Claudius.Bridge.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyBridge" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <BridgeFiles Include="..\Claudius.Bridge\bin\$(Configuration)\net10.0\ClaudiusBridge.exe;..\Claudius.Bridge\bin\$(Configuration)\net10.0\ClaudiusBridge.dll;..\Claudius.Bridge\bin\$(Configuration)\net10.0\ClaudiusBridge.deps.json;..\Claudius.Bridge\bin\$(Configuration)\net10.0\ClaudiusBridge.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
